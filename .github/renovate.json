{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "github-actions",
    "dockerfile"
  ],
  "schedule": [
    "before 9am on monday"
  ],
  "prHourlyLimit": 10,
  "packageRules": [
    {
      "matchManagers": [
        "github-actions",
        "dockerfile"
      ],
      "pinDigests": true,
      "automerge": false
    },
    {
      "description": "Temurin 태그 형식 (17.0.20.1_1-jre-jammy)",
      "matchDatasources": [
        "docker"
      ],
      "matchDepNames": [
        "eclipse-temurin"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.(?<build>\\d+))?_(?<revision>\\d+)-(?<compatibility>.+)$"
    }
  ]
}
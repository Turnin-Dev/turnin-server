{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "github-actions"
  ],
  "schedule": [
    "before 9am on monday"
  ],
  "prHourlyLimit": 10,
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true,
      "automerge": false
    }
  ]
}